# NestJS server
PORT=3000

# PostgreSQL (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fil_rouge
POSTGRES_PORT=5432

# Adminer (web interface for the database)
ADMINER_PORT=8080

# Used when the API runs outside Docker (npm run start:dev, drizzle-kit).
# In docker compose, it is replaced to point to the "db" service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fil_rouge

# Better Auth
# Secret of at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# Base URL of the API
BETTER_AUTH_URL=http://localhost:3000

# CORS: front-end origins allowed to call the API, comma-separated,
# without a trailing slash
CORS_ORIGIN=http://localhost:5173
