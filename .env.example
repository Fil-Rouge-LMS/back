# Serveur NestJS
PORT=3000

# PostgreSQL (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fil_rouge
POSTGRES_PORT=5432

# Adminer (interface web pour la base)
ADMINER_PORT=8080

# Utilisée quand l'API tourne hors Docker (npm run start:dev, drizzle-kit).
# Dans docker compose, elle est remplacée pour pointer vers le service "db".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fil_rouge
